generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// A t-shirt print position: the print image + product facts + SEO inputs, and the
/// generated copy in a shape that maps straight onto the WooCommerce REST API payload
/// (see docs/woocommerce-prompt-template.md).
model Position {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // ---------- inputs: the print ----------
  /// Main print name (human title).
  title     String
  /// The print image, stored inline in Postgres — deliberately NOT on a Railway volume.
  ///
  /// Postgres is a separate service with its own storage, so these bytes already survive a
  /// redeploy of the app. A volume would be a step backwards, not forwards: volume contents
  /// are not included in Railway's database backups, and the volume would pin the service to
  /// one region and one replica. Lose the volume and the prints are gone; lose the container
  /// and nothing happens at all.
  ///
  /// Revisit only if the catalogue grows to thousands of heavy prints, at which point the
  /// right move is object storage (S3/R2) with a URL here — not a disk.
  imageData Bytes?
  imageMime String?

  // ---------- inputs: product facts (fed to the model so it stops inventing them) ----------
  /// The CONCEPT CATEGORY — the brand's own taxonomy (one of the four). This is the lane the
  /// print speaks in: it decides meaning and voice, not search volume. Nobody types
  /// "tender thoughts t-shirt", and that is fine — that is not what a concept category is for.
  category    String @default("")

  /// The LISTING PAGE this product supports, inside its category — e.g. "Dark Botanical".
  /// Fixed BEFORE generation on purpose. It pins the trajectory: it tells the model which
  /// head terms are off-limits (the listing page owns them), and which siblings this print
  /// must stay distinguishable from. Without it the model re-guesses its lane every run, and
  /// sooner or later guesses its way into a neighbour's.
  cluster     String @default("")
  materials   String @default("")
  fit         String @default("")
  printMethod String @default("")
  sizes       String @default("")
  colors      String @default("")
  price       String @default("")
  extraNotes  String @default("")

  // ---------- inputs: SEO ----------
  /// The SEO title you want (the model may refine it, but must keep the primary keyword first).
  seoTitle String @default("")

  /// ANTI-CANNIBALIZATION: one primary keyword may target exactly one position.
  /// Enforced at the DB level so two prints can never compete for the same query.
  ///
  /// Nullable on purpose. A product's primary keyword is a long-tail phrase anchored on the
  /// motif that is actually printed on it — so it cannot honestly exist before the artwork
  /// has been imported and read. An empty primary means "not derived yet", which is a true
  /// statement; a placeholder head term would be a false one, and false head terms on
  /// product pages are exactly what this whole model exists to prevent.
  /// (Postgres allows many NULLs under a unique index, so unassigned positions coexist.)
  primaryKeyword String? @unique

  /// Supporting keywords, each used at most once in the long description.
  secondaryKeywords String[] @default([])

  // ---------- generated: the WooCommerce payload ----------
  /// URL handle — lowercase, hyphens, no diacritics.
  slug String @default("")
  /// Long description, HTML (<h3>/<p>/<strong>).
  description String @default("")
  /// 1–2 punchy sentences shown near Add to Cart. Must NOT restate the long description.
  shortDescription String @default("")
  /// <title> / rank_math_title — max 70 chars, primary keyword first.
  metaTitle String @default("")
  /// meta description — max 165 chars.
  seoDescription String @default("")
  /// 3–5 tags (style, fit, occasion — not category repeats).
  tags String[] @default([])
  /// 5 distinct alt texts: front, back, detail, worn/lifestyle, flat lay.
  imagesAlt String[] @default([])
  /// Matching filenames: [slug]_[view].jpg
  imageFilenames String[] @default([])

  /// Post-generation audit: what the model actually used, and what it refused to force.
  keywordsUsed Json?
  warnings     String[] @default([])

  status PositionStatus @default(DRAFT)

  @@index([status])
}

enum PositionStatus {
  DRAFT
  GENERATED
  APPROVED
}

/// The brand foundation. A single row (id = "default") that every generation is built on:
/// the concept and archetype come FIRST in the prompt, before the print and the keywords,
/// because they decide the voice. Change this and every future generation changes with it.
model BrandProfile {
  id        String   @id @default("default")
  updatedAt DateTime @updatedAt

  brandName String @default("Cretho")

  /// The core idea of the brand — its manifesto in a few sentences.
  concept String @default("")

  /// Brand archetype (e.g. The Magician, The Rebel, The Creator) — drives the voice.
  archetype String @default("")
  /// How that archetype actually shows up in copy: what it does and does not sound like.
  archetypeNotes String @default("")

  /// Who we are speaking to.
  audience String @default("")
  /// Tone rules, in plain language.
  toneOfVoice String @default("")
  /// What the brand actually promises the customer.
  valueProps String @default("")

  /// Preferred terminology ("tee" not "shirt", etc.).
  vocabulary String @default("")
  /// Words and phrases that must never appear in generated copy.
  bannedWords String[] @default([])
}

/// Reusable keyword list. Secondary keywords are picked from here.
/// A keyword already claimed by a Position as its PRIMARY is flagged in the UI so it
/// cannot be reused and cause cannibalization.
model Keyword {
  id        String      @id @default(cuid())
  createdAt DateTime    @default(now())
  text      String      @unique
  type      KeywordType @default(SECONDARY)

  /// Which of the three levels this secondary keyword serves. The tier is not a label —
  /// it decides WHERE the keyword is allowed to be placed (see lib/keywords.ts).
  tier KeywordTier @default(COMMERCIAL)

  /// THE TWO-LAYER RULE. When set, this keyword is owned by a listing page — a category or
  /// a collection — and is therefore OFF-LIMITS to every product page. Example:
  /// "Category: Gothic".
  ///
  /// Head terms like "gothic t-shirt" carry browsing intent: the searcher wants to pick from
  /// a range, not to buy one specific print. They belong on a page that shows a range. Park
  /// one on a product and you both disappoint the searcher and set that product against the
  /// category page for the same query. Products get long-tail, motif-anchored primaries
  /// instead — queries nothing else in the catalogue can claim.
  ///
  /// Anything with this set is merged into the reserved list that every generation is
  /// checked against, so the rule is enforced, not merely documented.
  reservedFor String?

  /// Optional grouping (collection, theme).
  topic String?
}

enum KeywordType {
  PRIMARY
  SECONDARY
}

/// The three levels a secondary keyword can serve. A well-built secondary set has all
/// three: together they define the product as an entity, which is what semantic search,
/// Google's product understanding and LLM retrieval actually consume.
enum KeywordTier {
  /// Real purchase intent — a query a buyer types. Lives in the description.
  COMMERCIAL
  /// Topical support — tells a search engine and an AI what world this belongs to.
  SEMANTIC
  /// The concrete object visible on the print. Must show up where the image is described.
  MOTIF
}
